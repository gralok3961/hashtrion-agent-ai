OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Shared hackathon password: non-empty; never expose to client code.
AGENT_AI_ACCESS_PASSWORD=
# Independent random session signing secret: at least 32 bytes.
AGENT_AI_SESSION_SECRET=
# Enable discovery/catalog for signed-in testers, including Azure production.
MERCHANT_DISCOVERY_ENABLED=false
# This Agent app's deployed public HTTPS /.well-known/ucp URL. Never a merchant URL.
UCP_PLATFORM_PROFILE_URL=
# Server-only Base64 PEM matching the published shopping-agent P-256 public key.
UCP_SIGNING_PRIVATE_KEY_BASE64=
# base URL, ending in /api, for the Development-only Agent ID connection purpose.
CONNECTION_API_BASE_URL=
